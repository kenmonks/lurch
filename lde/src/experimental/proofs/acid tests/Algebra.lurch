////////////////////////////////////////////////////////////////////
// Acid Test: the Algebra rule (by algebra via CAS)
//
// The by-algebra tool converts each side of an equation to Algebrite
// syntax STRUCTURALLY from the LC (algebraToCAS in parsing.js,
// 2026-07-28), replacing the old practice of passing the typed
// lurchNotation string to the CAS verbatim.  Consequences certified
// here: the identities from help/algebra-rule-examples.lurch (the
// web-app example document) validate in a test file whose LCs carry NO
// notation attribute; notation that is not Algebrite syntax (cdot, the
// ⋅ glyph, choose, the English summation form) works because only the
// MEANING is converted; and expressions outside the CAS fragment are
// inapplicable (⊘), never silently mis-sent.
//
// Inequalities and negations ride the Arithmetic-in-ℚ branch of the
// same tool, as before.  Symbolic-bound summations lock the current
// CAS limit: Algebrite cannot verify them, so they are indeterminate,
// exactly as when the typed string was passed verbatim.

➤ "Algebra rule examples (via CAS)"
Declare =, +, *, /, ^, !, choose, neq, leq, <

Rule: :{ AlgebraRule }

// valid identities from the example document.  (Whole-file parse
// protocol: this file is parsed as ONE input, and a line beginning with
// a sign would be absorbed into the preceding line's by-reason symbol
// as a signed sum, so -x+x=0 leads its block where nothing precedes it.)
{
  -x+x=0 ✔︎ by algebra
  x=x ✔︎ by algebra
  x=x+0 ✔︎ by algebra
  x=1*x ✔︎ by algebra
  x+y=y+x ✔︎ by algebra
  x*y=y*x ✔︎ by algebra
  (x+y)+z = x+(y+z) ✔︎ by algebra
  (x*y)*z = x*(y*z) ✔︎ by algebra
  x*(y+z)=x*y+x*z ✔︎ by algebra
  x+(-x)=0 ✔︎ by algebra
  x*(1/x)=1 ✔︎ by algebra
  (1/x)*x=1 ✔︎ by algebra
  x^0=1 ✔︎ by algebra
  x^a*x^b=x^(a+b) ✔︎ by algebra
  (x^a)^2=x^(2*a) ✔︎ by algebra
  x^3*y^3=(x*y)^3 ✔︎ by algebra
  1+2*3^4/5 = 33+2/5 ✔︎ by algebra
  (n+1)!/n!=n+1 ✔︎ by algebra
  (cos(x))^2+(sin(x))^2=1 ✔︎ by algebra
  cos(2*pi)=1 ✔︎ by algebra
  ln(x^2)=2*ln(x) ✔︎ by algebra
  sqrt(24)=2*sqrt(2)*sqrt(3) ✔︎ by algebra
}

// vectors and matrices (structural conversion to Algebrite tensors; a
// transpose tick is formatting-only, as before)
{
  [x,y]+[a,b]=[x+a,y+b] ✔︎ by algebra
  [x,y]'+[a,b]'=[x+a,y+b]' ✔︎ by algebra
  r*[a,b]=[r*a,r*b] ✔︎ by algebra
  [[x,y]]+[[a,b]]=[[x+a,y+b]] ✔︎ by algebra
  [[x],[y]]+[[a],[b]]=[[x+a],[y+b]] ✔︎ by algebra
  r*[[a],[b]]=[[r*a],[r*b]] ✔︎ by algebra
  det([[2,1],[1,2]])=3 ✔︎ by algebra
  det([[1-t,0,0],[0,5-t,0],[0,0,1-t]])=(1-t)^2*(5-t) ✔︎ by algebra
  adj([[2,1],[1,2]])=[[2,-1],[-1,2]] ✔︎ by algebra
  inv([[2,1],[1,2]])=1/3*[[2,-1],[-1,2]] ✔︎ by algebra
  dot([[t,1],[0,1]],[[2,0],[1,1]])=[[2*t+1,1],[1,1]] ✔︎ by algebra
}

// notation the old string path could never send to the CAS: only the
// meaning must lie in the CAS fragment, not the typed surface
{
  x cdot y = y cdot x ✔︎ by algebra
  2 ⋅ (w+1) = 2 cdot w + 2 ✔︎ by algebra
  n choose 2 = n*(n-1)/2 ✔︎ by algebra
  sum(k^2,k,1,5) = 55 ✔︎ by algebra
  sum k = 1 to 4 of k^3 = 100 ✔︎ by algebra
  product(k,k,1,4)=4! ✔︎ by algebra
  int x^2 dx = x^3/3 ✔︎ by algebra
  defint(x^2,x,0,1) = 1/3 ✔︎ by algebra
}

// inequalities and negations ride the Arithmetic-in-ℚ branch
{
  1/2 neq 2 ✔︎ by algebra
  19^17<17^19 ✔︎ by algebra
  3 leq 3 ✔︎ by algebra
}

// not identities: the CAS cannot verify these, so they are
// indeterminate (✗), including the symbolic-bound summation limit
{
  u*v=u+v ✗ by algebra
  (u+v)^2=u^2+v^2 ✗ by algebra
  sum(k,k,1,n) = n*(n+1)/2 ✗ by algebra
}

// outside the CAS fragment: inapplicable (⊘), never mis-sent
{
  set(a,b) = set(b,a) ⊘ by algebra
  A cup B = B cup A ⊘ by algebra
}
