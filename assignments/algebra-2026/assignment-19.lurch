<p><em><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;[R, oplus, odot] is a ring&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__left-right" style="margin-top: -0.19444em; height: 0.8777699999999999em;"><span class="ML__small-delim ML__open">⟨</span><span class="ML__mathit" style="margin-right: 0.01em;">R</span><span class="ML__cmr">,</span><span class="ML__cmr">⊕,</span><span class="ML__cmr">⊙</span><span class="ML__small-delim ML__close">⟩</span></span><span class="ML__text"> is a ring</span></span></span></span></span></em></p>
<p><em><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;R is commutative&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__mathit" style="margin-right: 0.01em;">R</span><span class="ML__text"> is commutative</span></span></span></span></span></em></p>
<p><em><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;R has identity&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__mathit" style="margin-right: 0.01em;">R</span><span class="ML__text"> has identity</span></span></span></span></span></em></p>
<p><em><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;1_(R) neq 0_(R)&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__cmr">1</span><span class="ML__msubsup"><span class="ML__vlist-t ML__vlist-t2"><span class="ML__vlist-r"><span class="ML__vlist" style="height: 0.33em;"><span style="top: -2.85em; margin-right: 0.05em;"><span style="height: 0.48em; display: inline-block; font-size: 70%;"><span class="ML__mathit" style="margin-right: 0.01em;">R</span></span></span></span><span class="ML__vlist-s">​</span></span></span></span><span class="ML__rlap"><span class="ML__inner"><span class="ML__cmr"></span></span></span><span class="ML__cmr">=</span><span class="ML__cmr">0</span><span class="ML__msubsup"><span class="ML__vlist-t ML__vlist-t2"><span class="ML__vlist-r"><span class="ML__vlist" style="height: 0.33em;"><span style="top: -2.85em; margin-right: 0.05em;"><span style="height: 0.48em; display: inline-block; font-size: 70%;"><span class="ML__mathit" style="margin-right: 0.01em;">R</span></span></span></span><span class="ML__vlist-s">​</span></span></span></span></span></span></span></span></em></p>
<div class="lurch-atom unindented" data-metadata_type="&quot;subproof&quot;" data-shell_title="">
<p><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;Let a,b in R, a odot b = 0_(R)&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__text">Let </span><span class="ML__mathit">a</span><span class="ML__cmr">,</span><span class="ML__mathit">b</span><span class="ML__cmr">∈</span><span class="ML__mathit" style="margin-right: 0.01em;">R</span><span style="color: #000000;"><span class="ML__text"> and </span></span><span class="ML__mathit">a</span><span class="ML__cmr">⊙</span><span class="ML__mathit">b</span><span class="ML__cmr">=</span><span class="ML__cmr">0</span><span class="ML__msubsup"><span class="ML__vlist-t ML__vlist-t2"><span class="ML__vlist-r"><span class="ML__vlist" style="height: 0.33em;"><span style="top: -2.85em; margin-right: 0.05em;"><span style="height: 0.48em; display: inline-block; font-size: 70%;"><span class="ML__mathit" style="margin-right: 0.01em;">R</span></span></span></span><span class="ML__vlist-s">​</span></span></span></span></span></span></span></span>.</p>
<p><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;a=0_(R) or b=0_(R)&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__mathit">a</span><span class="ML__cmr">=</span><span class="ML__cmr">0</span><span class="ML__msubsup"><span class="ML__vlist-t ML__vlist-t2"><span class="ML__vlist-r"><span class="ML__vlist" style="height: 0.33em;"><span style="top: -2.85em; margin-right: 0.05em;"><span style="height: 0.48em; display: inline-block; font-size: 70%;"><span class="ML__mathit" style="margin-right: 0.01em;">R</span></span></span></span><span class="ML__vlist-s">​</span></span></span></span><span class="ML__text"> or </span><span class="ML__mathit">b</span><span class="ML__cmr">=</span><span class="ML__cmr">0</span><span class="ML__msubsup"><span class="ML__vlist-t ML__vlist-t2"><span class="ML__vlist-r"><span class="ML__vlist" style="height: 0.33em;"><span style="top: -2.85em; margin-right: 0.05em;"><span style="height: 0.48em; display: inline-block; font-size: 70%;"><span class="ML__mathit" style="margin-right: 0.01em;">R</span></span></span></span><span class="ML__vlist-s">​</span></span></span></span></span></span></span></span></p>
</div>
</div>
<p><em>Conclude&nbsp;</em><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;R is an integral domain&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__mathit" style="margin-right: 0.01em;">R</span><span class="ML__text"> is an integral domain</span></span></span></span></span></p>
</div>
<div class="lurch-atom unindented" data-metadata_type="&quot;rule&quot;" data-shell_title="Rule:">
<p><strong>Definition (field)</strong> <span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;If [R, oplus, odot] is a ring, R is a field, x in R, x neq 0_(R), 1_(R) neq 0_(R)&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__text">If </span><span class="ML__left-right" style="margin-top: -0.19444em; height: 0.8777699999999999em;"><span class="ML__small-delim ML__open">⟨</span><span class="ML__mathit" style="margin-right: 0.01em;">R</span><span class="ML__cmr">,</span><span class="ML__cmr">⊕,</span><span class="ML__cmr">⊙</span><span class="ML__small-delim ML__close">⟩</span></span><span class="ML__text"> is a ring, </span><span class="ML__mathit" style="margin-right: 0.01em;">R</span><span class="ML__text"> is a field, </span><span class="ML__mathit">x</span><span class="ML__cmr">∈</span><span class="ML__mathit" style="margin-right: 0.01em;">R</span><span class="ML__text">, </span><span class="ML__mathit">x</span><span class="ML__rlap"><span class="ML__inner"><span class="ML__cmr"></span></span></span><span class="ML__cmr">=</span><span class="ML__cmr">0</span><span class="ML__msubsup"><span class="ML__vlist-t ML__vlist-t2"><span class="ML__vlist-r"><span class="ML__vlist" style="height: 0.33em;"><span style="top: -2.85em; margin-right: 0.05em;"><span style="height: 0.48em; display: inline-block; font-size: 70%;"><span class="ML__mathit" style="margin-right: 0.01em;">R</span></span></span></span><span class="ML__vlist-s">​</span></span></span></span><span style="color: #000000;"><span class="ML__text"> and </span></span><span class="ML__cmr">1</span><span class="ML__msubsup"><span class="ML__vlist-t ML__vlist-t2"><span class="ML__vlist-r"><span class="ML__vlist" style="height: 0.33em;"><span style="top: -2.85em; margin-right: 0.05em;"><span style="height: 0.48em; display: inline-block; font-size: 70%;"><span class="ML__mathit" style="margin-right: 0.01em;">R</span></span></span></span><span class="ML__vlist-s">​</span></span></span></span><span class="ML__rlap"><span class="ML__inner"><span class="ML__cmr"></span></span></span><span class="ML__cmr">=</span><span class="ML__cmr">0</span><span class="ML__msubsup"><span class="ML__vlist-t ML__vlist-t2"><span class="ML__vlist-r"><span class="ML__vlist" style="height: 0.33em;"><span style="top: -2.85em; margin-right: 0.05em;"><span style="height: 0.48em; display: inline-block; font-size: 70%;"><span class="ML__mathit" style="margin-right: 0.01em;">R</span></span></span></span><span class="ML__vlist-s">​</span></span></span></span></span></span></span></span> then <span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;x^- in R&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__mathit">x</span><span class="ML__msubsup"><span class="ML__vlist-t"><span class="ML__vlist-r"><span class="ML__vlist" style="height: 0.83em;"><span style="top: -3.41em; margin-right: 0.05em;"><span style="height: 0.47em; display: inline-block; font-size: 70%;"><span class="ML__cmr">−</span></span></span></span></span></span></span><span class="ML__cmr">∈</span><span class="ML__mathit" style="margin-right: 0.01em;">R</span></span></span></span></span>, i.e., every nonzero element of a field is a unit.</p>
</div>
<div class="lurch-atom unindented" data-metadata_type="&quot;rule&quot;" data-shell_title="Rule:">
<p><strong>Definition (field)</strong></p>
<div class="lurch-atom unindented" data-metadata_type="&quot;premise&quot;" data-shell_title="Premise:">
<p><em>Given<br><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;[R, oplus, odot] is a ring&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__left-right" style="margin-top: -0.19444em; height: 0.8777699999999999em;"><span class="ML__small-delim ML__open">⟨</span><span class="ML__mathit" style="margin-right: 0.01em;">R</span><span class="ML__cmr">,</span><span class="ML__cmr">⊕,</span><span class="ML__cmr">⊙</span><span class="ML__small-delim ML__close">⟩</span></span><span class="ML__text"> is a ring</span></span></span></span></span><br></em></p>
<p><em><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;1_(R) neq 0_(R)&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__cmr">1</span><span class="ML__msubsup"><span class="ML__vlist-t ML__vlist-t2"><span class="ML__vlist-r"><span class="ML__vlist" style="height: 0.33em;"><span style="top: -2.85em; margin-right: 0.05em;"><span style="height: 0.48em; display: inline-block; font-size: 70%;"><span class="ML__mathit" style="margin-right: 0.01em;">R</span></span></span></span><span class="ML__vlist-s">​</span></span></span></span><span class="ML__rlap"><span class="ML__inner"><span class="ML__cmr"></span></span></span><span class="ML__cmr">=</span><span class="ML__cmr">0</span><span class="ML__msubsup"><span class="ML__vlist-t ML__vlist-t2"><span class="ML__vlist-r"><span class="ML__vlist" style="height: 0.33em;"><span style="top: -2.85em; margin-right: 0.05em;"><span style="height: 0.48em; display: inline-block; font-size: 70%;"><span class="ML__mathit" style="margin-right: 0.01em;">R</span></span></span></span><span class="ML__vlist-s">​</span></span></span></span></span></span></span></span></em></p>
<div class="lurch-atom unindented" data-metadata_type="&quot;subproof&quot;" data-shell_title="">
<p><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;Let x in R&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__text">Let </span><span class="ML__mathit">x</span><span class="ML__cmr">∈</span><span class="ML__mathit" style="margin-right: 0.01em;">R</span></span></span></span></span></p>
<p><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;x is a unit in R&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__mathit">x</span><span class="ML__text"> is a unit in </span><span class="ML__mathit" style="margin-right: 0.01em;">R</span></span></span></span></span></p>
</div>
</div>
<p><em>Conclude <span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;R is a field&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__mathit" style="margin-right: 0.01em;">R</span><span class="ML__text"> is a field</span></span></span></span></span></em></p>
</div>
<div class="lurch-atom unindented" data-metadata_type="&quot;rule&quot;" data-shell_title="Rule:">
<p><strong>Definition (subring)&nbsp;</strong><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;If [R, oplus, odot] is a ring, S is a subring of R&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__text">If </span><span class="ML__left-right" style="margin-top: -0.19444em; height: 0.8777699999999999em;"><span class="ML__small-delim ML__open">⟨</span><span class="ML__mathit" style="margin-right: 0.01em;">R</span><span class="ML__cmr">,</span><span class="ML__cmr">⊕,</span><span class="ML__cmr">⊙</span><span class="ML__small-delim ML__close">⟩</span></span><span class="ML__text"> is a ring</span><span style="color: #000000;"><span class="ML__text"> and </span></span><span class="ML__mathit" style="margin-right: 0.06em;">S</span><span class="ML__text"> is a subring of </span><span class="ML__mathit" style="margin-right: 0.01em;">R</span></span></span></span></span> then</p>
<p>1. <span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;S subset R&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__mathit" style="margin-right: 0.06em;">S</span><span class="ML__cmr">⊆</span><span class="ML__mathit" style="margin-right: 0.01em;">R</span></span></span></span></span></p>
<p>2. <span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;If a in S then -a in S&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__text">If </span><span class="ML__mathit">a</span><span class="ML__cmr">∈</span><span class="ML__mathit" style="margin-right: 0.06em;">S</span><span class="ML__text"> then </span><span class="ML__cmr">−</span><span class="ML__mathit">a</span><span class="ML__cmr">∈</span><span class="ML__mathit" style="margin-right: 0.06em;">S</span></span></span></span></span>, and&nbsp;</p>
<p>2. <span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;If a,b in S&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__text">If </span><span class="ML__mathit">a</span><span class="ML__cmr">,</span><span class="ML__mathit">b</span><span class="ML__cmr">∈</span><span class="ML__mathit" style="margin-right: 0.06em;">S</span></span></span></span></span> then&nbsp; <span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;a oplus b in S&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__mathit">a</span><span class="ML__cmr">⊕</span><span class="ML__mathit">b</span><span class="ML__cmr">∈</span><span class="ML__mathit" style="margin-right: 0.06em;">S</span></span></span></span></span> and <span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;a odot b in S&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__mathit">a</span><span class="ML__cmr">⊙</span><span class="ML__mathit">b</span><span class="ML__cmr">∈</span><span class="ML__mathit" style="margin-right: 0.06em;">S</span></span></span></span></span>.</p>
</div>
<div class="lurch-atom unindented" data-metadata_type="&quot;rule&quot;" data-shell_title="Rule:">
<p><strong>Theorem (subring)&nbsp;</strong></p>
<div class="lurch-atom unindented" data-metadata_type="&quot;premise&quot;" data-shell_title="Premise:">
<p><em>Given</em></p>
<p><em><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;[R, oplus, odot] is a ring&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__left-right" style="margin-top: -0.19444em; height: 0.8777699999999999em;"><span class="ML__small-delim ML__open">⟨</span><span class="ML__mathit" style="margin-right: 0.01em;">R</span><span class="ML__cmr">,</span><span class="ML__cmr">⊕,</span><span class="ML__cmr">⊙</span><span class="ML__small-delim ML__close">⟩</span></span><span class="ML__text"> is a ring</span></span></span></span></span></em></p>
<p><em><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;S subset R&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__mathit" style="margin-right: 0.06em;">S</span><span class="ML__cmr">⊆</span><span class="ML__mathit" style="margin-right: 0.01em;">R</span></span></span></span></span></em></p>
<div class="lurch-atom unindented" data-metadata_type="&quot;subproof&quot;" data-shell_title="">
<p><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;Let a,b in S&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__text">Let </span><span class="ML__mathit">a</span><span class="ML__cmr">,</span><span class="ML__mathit">b</span><span class="ML__cmr">∈</span><span class="ML__mathit" style="margin-right: 0.06em;">S</span></span></span></span></span></p>
<p><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;a oplus (-b) in S&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__mathit">a</span><span class="ML__cmr">⊕</span><span class="ML__left-right" style="margin-top: -0.08333em; height: 0.77777em;"><span class="ML__small-delim ML__open">(</span><span class="ML__cmr">−</span><span class="ML__mathit">b</span><span class="ML__small-delim ML__close">)</span></span><span class="ML__cmr">∈</span><span class="ML__mathit" style="margin-right: 0.06em;">S</span></span></span></span></span></p>
<p><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;a odot b in S&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__mathit">a</span><span class="ML__cmr">⊙</span><span class="ML__mathit">b</span><span class="ML__cmr">∈</span><span class="ML__mathit" style="margin-right: 0.06em;">S</span></span></span></span></span></p>
</div>
</div>
<p><em>Conclude</em></p>
<p><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;S is a subring of R&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__mathit" style="margin-right: 0.06em;">S</span><span class="ML__text"> is a subring of </span><span class="ML__mathit" style="margin-right: 0.01em;">R</span></span></span></span></span></p>
</div>
<div class="lurch-atom unindented" data-metadata_type="&quot;rule&quot;" data-shell_title="Rule:">
<p><strong>Theorem (Cartesian product of rings)</strong></p>
<div class="lurch-atom unindented" data-metadata_type="&quot;premise&quot;" data-shell_title="Premise:">
<p><em>Given</em></p>
<p><em><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;[R,oplus,odot] is a ring&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__left-right" style="margin-top: -0.19444em; height: 0.8777699999999999em;"><span class="ML__small-delim ML__open">⟨</span><span class="ML__mathit" style="margin-right: 0.01em;">R</span><span class="ML__cmr">,</span><span class="ML__cmr">⊕,</span><span class="ML__cmr">⊙</span><span class="ML__small-delim ML__close">⟩</span></span><span class="ML__text"> is a ring</span></span></span></span></span></em></p>
<p><em><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;[S,dotplus,oast] is a ring&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__left-right" style="margin-top: -0.19444em; height: 0.8866799999999999em;"><span class="ML__small-delim ML__open">⟨</span><span class="ML__mathit" style="margin-right: 0.06em;">S</span><span class="ML__cmr">,</span><span class="ML__ams">∔</span><span class="ML__cmr">,</span><span class="ML__ams">⊛</span><span class="ML__small-delim ML__close">⟩</span></span><span class="ML__text"> is a ring</span></span></span></span></span></em></p>
<p><em><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;boxplus:(R cross S) cross (R cross S) to R cross S&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__ams">⊞</span><span class="ML__cmr">:</span><span class="ML__left-right" style="margin-top: -0.08333em; height: 0.76666em;"><span class="ML__small-delim ML__open">(</span><span class="ML__mathit" style="margin-right: 0.01em;">R</span><span class="ML__cmr">×</span><span class="ML__mathit" style="margin-right: 0.06em;">S</span><span class="ML__small-delim ML__close">)</span></span><span class="ML__cmr">×</span><span class="ML__left-right" style="margin-top: -0.08333em; height: 0.76666em;"><span class="ML__small-delim ML__open">(</span><span class="ML__mathit" style="margin-right: 0.01em;">R</span><span class="ML__cmr">×</span><span class="ML__mathit" style="margin-right: 0.06em;">S</span><span class="ML__small-delim ML__close">)</span></span><span class="ML__cmr">→</span><span class="ML__mathit" style="margin-right: 0.01em;">R</span><span class="ML__cmr">×</span><span class="ML__mathit" style="margin-right: 0.06em;">S</span></span></span></span></span></em></p>
<p><em><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;boxdot:(R cross S) cross (R cross S) to R cross S&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__ams">⊡</span><span class="ML__cmr">:</span><span class="ML__left-right" style="margin-top: -0.08333em; height: 0.76666em;"><span class="ML__small-delim ML__open">(</span><span class="ML__mathit" style="margin-right: 0.01em;">R</span><span class="ML__cmr">×</span><span class="ML__mathit" style="margin-right: 0.06em;">S</span><span class="ML__small-delim ML__close">)</span></span><span class="ML__cmr">×</span><span class="ML__left-right" style="margin-top: -0.08333em; height: 0.76666em;"><span class="ML__small-delim ML__open">(</span><span class="ML__mathit" style="margin-right: 0.01em;">R</span><span class="ML__cmr">×</span><span class="ML__mathit" style="margin-right: 0.06em;">S</span><span class="ML__small-delim ML__close">)</span></span><span class="ML__cmr">→</span><span class="ML__mathit" style="margin-right: 0.01em;">R</span><span class="ML__cmr">×</span><span class="ML__mathit" style="margin-right: 0.06em;">S</span></span></span></span></span></em></p>
<div class="lurch-atom unindented" data-metadata_type="&quot;subproof&quot;" data-shell_title="">
<p><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;Let r,s,u,v be such that r,u in R, s,v in S &quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__text">Let </span><span class="ML__mathit" style="margin-right: 0.03em;">r</span><span class="ML__text">, </span><span class="ML__mathit">s</span><span class="ML__text">, </span><span class="ML__mathit">u</span><span style="color: #000000;"><span class="ML__text"> and </span></span><span class="ML__mathit" style="margin-right: 0.04em;">v</span><span style="color: #000000;"><span class="ML__text"> be such that </span></span><span class="ML__mathit" style="margin-right: 0.03em;">r</span><span class="ML__cmr">,</span><span class="ML__mathit">u</span><span class="ML__cmr">∈</span><span class="ML__mathit" style="margin-right: 0.01em;">R</span><span class="ML__cmr">,</span><span class="ML__mathit">s</span><span style="color: #000000;"><span class="ML__text"> and </span></span><span class="ML__mathit" style="margin-right: 0.04em;">v</span><span class="ML__cmr">∈</span><span class="ML__mathit" style="margin-right: 0.06em;">S</span></span></span></span></span></p>
<p><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;[r,s] boxplus [u,v] = [r oplus u, s dotplus v]&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__left-right" style="margin-top: -0.19444em; height: 0.625em;"><span class="ML__small-delim ML__open">⟨</span><span class="ML__mathit" style="margin-right: 0.03em;">r</span><span class="ML__cmr">,</span><span class="ML__mathit">s</span><span class="ML__small-delim ML__close">⟩</span></span><span class="ML__ams">⊞</span><span class="ML__left-right" style="margin-top: -0.19444em; height: 0.625em;"><span class="ML__small-delim ML__open">⟨</span><span class="ML__mathit">u</span><span class="ML__cmr">,</span><span class="ML__mathit" style="margin-right: 0.04em;">v</span><span class="ML__small-delim ML__close">⟩</span></span><span class="ML__cmr">=</span><span class="ML__left-right" style="margin-top: -0.19444em; height: 0.8866799999999999em;"><span class="ML__small-delim ML__open">⟨</span><span class="ML__mathit" style="margin-right: 0.03em;">r</span><span class="ML__cmr">⊕</span><span class="ML__mathit">u</span><span class="ML__cmr">,</span><span class="ML__mathit">s</span><span class="ML__ams">∔</span><span class="ML__mathit" style="margin-right: 0.04em;">v</span><span class="ML__small-delim ML__close">⟩</span></span></span></span></span></span></p>
<p><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;[r,s] boxdot [u,v] = [r odot u, s oast v]&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__left-right" style="margin-top: -0.19444em; height: 0.625em;"><span class="ML__small-delim ML__open">⟨</span><span class="ML__mathit" style="margin-right: 0.03em;">r</span><span class="ML__cmr">,</span><span class="ML__mathit">s</span><span class="ML__small-delim ML__close">⟩</span></span><span class="ML__ams">⊡</span><span class="ML__left-right" style="margin-top: -0.19444em; height: 0.625em;"><span class="ML__small-delim ML__open">⟨</span><span class="ML__mathit">u</span><span class="ML__cmr">,</span><span class="ML__mathit" style="margin-right: 0.04em;">v</span><span class="ML__small-delim ML__close">⟩</span></span><span class="ML__cmr">=</span><span class="ML__left-right" style="margin-top: -0.19444em; height: 0.7777700000000001em;"><span class="ML__small-delim ML__open">⟨</span><span class="ML__mathit" style="margin-right: 0.03em;">r</span><span class="ML__cmr">⊙</span><span class="ML__mathit">u</span><span class="ML__cmr">,</span><span class="ML__mathit">s</span><span class="ML__ams">⊛</span><span class="ML__mathit" style="margin-right: 0.04em;">v</span><span class="ML__small-delim ML__close">⟩</span></span></span></span></span></span></p>
</div>
</div>
<p><em>Conclude &nbsp;<span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;[R cross S,boxplus,boxdot] is a ring&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__left-right" style="margin-top: -0.19444em; height: 0.8777699999999999em;"><span class="ML__small-delim ML__open">⟨</span><span class="ML__mathit" style="margin-right: 0.01em;">R</span><span class="ML__cmr">×</span><span class="ML__mathit" style="margin-right: 0.06em;">S</span><span class="ML__cmr">,</span><span class="ML__ams">⊞</span><span class="ML__cmr">,</span><span class="ML__ams">⊡</span><span class="ML__small-delim ML__close">⟩</span></span><span class="ML__text"> is a ring</span></span></span></span></span></em>&nbsp;</p>
</div></div>
